IDD_GENERALDLG DIALOGEX 20, 20, 252, 214
STYLE DS_SETFONT | DS_CONTROL | DS_FIXEDSYS | WS_CHILD | WS_TABSTOP
CAPTION "General"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX "Display",2030,7,9,237,84
    LTEXT "If your screen resolution makes screen items too small to view comfortably, you can increase the DPI to compensate. To change font sizes only, click Cancel and go to the Appearance tab.",2036,13,20,220,24
    LTEXT "DPI setting:",2037,13,50,70,8
    COMBOBOX 2031,13,58,140,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Normal size (96 dpi)",2038,13,76,120,8
    GROUPBOX "Compatibility",2032,7,98,237,108
    LTEXT "Some programs might not operate properly unless you restart the computer after changing display settings.",2039,13,109,220,17
    LTEXT "After I change display settings:",2049,13,132,180,8
    AUTORADIOBUTTON "Restart the computer before applying the new display settings",2033,13,143,220,10
    AUTORADIOBUTTON "Apply the new display settings without restarting",2034,13,156,220,10
    AUTORADIOBUTTON "Ask me before applying the new display settings",2035,13,169,220,10
    LTEXT "Some games and other programs must be run in 256-color mode.",2051,13,184,220,8
    LTEXT "Learn more about running programs in 256-color mode.",2052,13,191,220,8
END

IDD_CUSTOMDPIDLG DIALOGEX 0, 0, 252, 152
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
