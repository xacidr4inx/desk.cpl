CAPTION "Custom DPI Setting"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT "For a custom DPI setting, select a percentage from the list, or drag the ruler with your mouse.",IDC_CUSTOMDPIDESC,15,7,222,24
